# Supabase Cloud Configuration (Client-side public anon credentials only)
# Enable Anonymous Sign-Ins in Supabase Dashboard -> Authentication -> Providers -> Anonymous Sign-Ins
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional backend puzzle SQLite database path (defaults to ./data/puzzles.db)
PUZZLE_DB_PATH="./data/puzzles.db"
